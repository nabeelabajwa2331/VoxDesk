# "true" runs the app against the in-browser demo API (src/mocks). Nothing is persisted.
VITE_USE_MOCKS=true

# Base URL for the real backend. Leave as /api to use the dev proxy below.
VITE_API_BASE_URL=/api

# Dev only: where the Vite dev server forwards /api requests (the FastAPI server).
VITE_DEV_API_PROXY=http://localhost:8000
